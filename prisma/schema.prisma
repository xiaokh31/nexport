// Prisma schema for the company website
// 全栈物流系统数据库模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户认证 ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  company       String?
  // 通知设置
  emailNotifications Boolean @default(true)
  quoteEmailUpdates  Boolean @default(true)
  // 员工特殊权限
  canManageArticles  Boolean @default(false)  // 员工管理文章权限
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  quotes        Quote[]
  deletedQuotes Quote[]      @relation("QuoteDeletedBy")
  quoteEvents   QuoteEvent[] @relation("QuoteEventActor")
  articles      Article[]    @relation("ArticleAuthor")
  notifications Notification[]
  broadcastsCreated  NotificationBroadcast[] @relation("NotificationBroadcastActor")
  broadcastsTargeted NotificationBroadcast[] @relation("NotificationBroadcastTarget")
  loginHistory  LoginHistory[]
  // 用户语言偏好
  locale        String @default("en") //'zh' | 'en' | 'fr'
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN           // 系统管理员
  STAFF           // 员工
  WAREHOUSE       // 仓库管理员
  FINANCE         // 财务
  CUSTOMER        // 客户
  PARTNER         // 合作伙伴
}

// ==================== 询价系统 ====================

model Quote {
  id                    String         @id @default(cuid())
  reference             String         @unique
  submissionKey         String         @unique @db.Uuid
  submissionFingerprint String         @db.Char(64)
  userId                String?
  name                  String
  email                 String
  phone                 String
  company               String?
  serviceType           ServiceType
  origin                String?
  destination           String?
  cargoType             String?
  pieceCount            Int?
  cartonCount           Int?
  palletCount           Int?
  weightValue           Decimal?       @db.Decimal(14, 3)
  weightUnit            WeightUnit?
  length                Decimal?       @db.Decimal(12, 3)
  width                 Decimal?       @db.Decimal(12, 3)
  height                Decimal?       @db.Decimal(12, 3)
  dimensionUnit         DimensionUnit?
  requestedDate         DateTime?      @db.Date
  message               String         @db.Text
  status                QuoteStatus    @default(PENDING)
  amount                Decimal?       @db.Decimal(14, 2)
  currency              String?        @db.Char(3)
  customerNote          String?        @db.Text
  internalNote          String?        @db.Text
  quotedAt              DateTime?
  deletedAt             DateTime?
  deletedById           String?
  deleteReason          String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user       User?        @relation(fields: [userId], references: [id])
  deletedBy  User?        @relation("QuoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  events     QuoteEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model QuoteEvent {
  id          String      @id @default(cuid())
  quoteId     String
  actorId     String?
  fromStatus  QuoteStatus
  toStatus    QuoteStatus
  reason      String?     @db.Text
  requestKey  String      @unique @db.Uuid
  createdAt   DateTime    @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor User? @relation("QuoteEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}

enum ServiceType {
  FBA_LAST_MILE
  TRUCK_FREIGHT
  CROSS_BORDER
  AMAZON_FBA
  EXPRESS
  WAREHOUSE
  DROPSHIPPING
  RETURNS
  OTHER
}

enum WeightUnit {
  KG
  LB
}

enum DimensionUnit {
  CM
  IN
}

enum QuoteStatus {
  PENDING       // 待处理
  PROCESSING    // 处理中
  QUOTED        // 已报价
  ACCEPTED      // 已接受
  REJECTED      // 已拒绝
  CLOSED        // 已关闭
}

// ==================== 新闻/文章系统 ====================

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImage     String?
  coverImageAlt  String?
  seoTitle       String?
  seoDescription String?       @db.Text
  authorId       String?
  author         String        // 作者展示名快照
  category       String
  tags           String[]
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?     // 首次发布时间，归档或重发时不重置
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authorUser User? @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status, publishedAt])
}

enum ArticleStatus {
  DRAFT       // 草稿
  PUBLISHED   // 已发布
  ARCHIVED    // 已归档
}

// ==================== 系统配置 ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 消息通知系统 ====================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  eventKey  String?
  type      NotificationType
  title     String
  content   String           @db.Text
  link      String?          // 点击跳转链接
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, isRead, createdAt])
  @@index([isRead])
  @@index([type])
}

model EmailOutbox {
  id                String            @id @default(cuid())
  idempotencyKey    String            @unique @db.VarChar(256)
  eventKey          String
  recipient         String
  payload           Json
  status            EmailOutboxStatus @default(PENDING)
  attemptCount      Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  lockedAt          DateTime?
  firstAttemptAt    DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([eventKey])
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  MANUAL_REVIEW
}

model NotificationBroadcast {
  id                 String                     @id @default(cuid())
  requestKey         String                     @unique @db.Uuid
  payloadFingerprint String                     @db.Char(64)
  actorId            String?
  targetScope        NotificationBroadcastScope
  targetUserId       String?
  type               NotificationType
  title              String
  content            String                     @db.Text
  link               String?
  recipientCount     Int
  createdAt          DateTime                   @default(now())

  actor      User? @relation("NotificationBroadcastActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("NotificationBroadcastTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum NotificationBroadcastScope {
  ALL_USERS
  USER
}

enum NotificationType {
  SYSTEM        // 系统通知
  QUOTE         // 询价相关
  ORDER         // 订单相关
  PROMOTION     // 促销活动
  NEWS          // 新闻动态
  ALERT         // 警告通知
}

// ==================== 登录历史 ====================

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  ip          String?
  userAgent   String?
  device      String?
  location    String?
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  action      String   @db.VarChar(64)
  keyHash     String   @db.Char(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, keyHash, windowStart])
  @@index([expiresAt])
}

// ==================== 页面内容管理 ====================

model Page {
  id          String      @id @default(cuid())
  slug        String      @unique  // 如 "privacy", "terms"
  title       String               // 页面标题
  titleEn     String?              // 英文标题
  titleFr     String?              // 法文标题
  content     String      @db.Text // Markdown 内容（禁止原始 HTML）
  contentEn   String?     @db.Text // 英文内容
  contentFr   String?     @db.Text // 法文内容
  status      PageStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

enum PageStatus {
  DRAFT       // 草稿
  PUBLISHED   // 已发布
}
