# Build-time configuration
# Reserved .invalid hosts and empty secrets are intentionally unusable placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@database.example.invalid:5432/DATABASE?schema=public"
NEXT_PUBLIC_SITE_URL="https://www.example.invalid"

# Authentication (required only by authentication runtime entry points)
NEXTAUTH_SECRET=""

# Optional Google OAuth provider; configure both values or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CAPTCHA (required by protected public-form runtime entry points)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Email (required only when email delivery is enabled)
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_TO=""

# Persistent rate limiting (required by protected runtime entry points)
RATE_LIMIT_SECRET=""
TRUSTED_PROXY_HOPS="0"

# Optional search-engine ownership verification
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
BAIDU_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""
