# Build-time configuration
# Reserved .invalid hosts and empty secrets are intentionally unusable placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@database.example.invalid:5432/DATABASE?schema=public"
NEXT_PUBLIC_SITE_URL="https://www.example.invalid"

# Isolated test database. Destructive test commands additionally require the
# marker, a local host, a non-default PostgreSQL port, and a *_test database.
DATABASE_URL_TEST="postgresql://nexport_test:nexport_test_password@127.0.0.1:55432/nexport_test?schema=public&application_name=nexport-test-only"
TEST_DATABASE_MARKER="nexport-test-only"
TEST_POSTGRES_PORT="55432"
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3100"

# Authentication (required only by authentication runtime entry points)
NEXTAUTH_SECRET=""

# Optional Google OAuth provider; configure both values or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CAPTCHA (required by protected public-form runtime entry points)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Email (required only when email delivery is enabled)
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_TO=""

# Protected email-outbox worker endpoint (minimum 32 bytes)
CRON_SECRET=""

# Persistent rate limiting (required by protected runtime entry points;
# RATE_LIMIT_SECRET must contain at least 32 bytes)
RATE_LIMIT_SECRET=""
# 0 ignores forwarding headers; otherwise set the exact trusted proxy hop count.
TRUSTED_PROXY_HOPS="0"

# Optional search-engine ownership verification
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
BAIDU_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""
